<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="@color/scrim">

    <TextView
        android:id="@+id/blockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/block_title"
        android:textColor="@color/fuel"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/blockBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/block_body"
        android:textColor="@color/muted"
        android:textSize="15sp"
        android:gravity="center" />

    <Button
        android:id="@+id/blockStudy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/block_study"
        android:textColor="@color/bg"
        android:backgroundTint="@color/fuel" />

    <Button
        android:id="@+id/blockOk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/block_ok"
        android:textColor="@color/ink"
        android:backgroundTint="@color/panel2" />
</LinearLayout>
